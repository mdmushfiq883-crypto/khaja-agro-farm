# ==============================================================================
# Git Ignore Rules for Khaja Agro Farm
# Strictly prevents database data, credentials, and secrets from being committed
# ==============================================================================

# SQLite database files, WAL logs, and temporary shared memory files
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Environment secrets and credentials (CRITICAL: NEVER commit secrets)
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
!.env.example

# Backups and temporary migration dumps
backups/
pptx_unpacked/
*.bak
*.dump
*.tar
*.tar.gz
*.zip

# Application runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node modules (if any future tooling is used)
node_modules/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
